               <rdf:li xml:lang="x-default">An improved stent which is easly recaptured and repositioned within the body - European Patent Office - EP 1000590 A1</rdf:li>
               <rdf:li xml:lang="en">An improved stent which is easly recaptured and repositioned within the body - European Patent Office - EP 1000590 A1</rdf:li>
            </rdf:Alt>
