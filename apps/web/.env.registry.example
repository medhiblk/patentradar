# PatentRadar audited public endpoint registry — generated from verification.json
# Endpoint counts are not provider counts. Empty/blocked/HTML responses are not successful APIs.
# A = verified metadata/retrieval scope only; content rights and quotas remain applicable.

# ===== TIER A (55 endpoints) =====
# Global | arxiv | Preprint search Atom XML
# GET | REST | CC0 descriptive metadata; full e-print files retain individual licences. One connection and >=3 seconds between API calls.
# Observed 200 | XML | At least 3 seconds between calls; one connection.
ARXIV_API_URL=https://export.arxiv.org/api/query

# Global | crossref | Scientific metadata keyword search
# GET | REST | CC0 metadata; abstracts and full text may have separate rights. Do not redistribute abstracts by default.
# Observed 200 | JSON | Public lists 1 request/s; single record 5/s; obey response headers.
CROSSREF_API_URL=https://api.crossref.org/works

# Global | crossref | Resolve DOI metadata and supplied references
# GET | REST | CC0 metadata; abstracts and full text may have separate rights. Do not redistribute abstracts by default.
# Observed 200 | JSON | Public lists 1 request/s; single record 5/s; obey response headers.
CROSSREF_DOI_URL=https://api.crossref.org/works/{doi}

# Global | crossref | Funding organization lookup
# GET | REST | CC0 metadata; abstracts and full text may have separate rights. Do not redistribute abstracts by default.
# Observed 200 | JSON | Public lists 1 request/s; single record 5/s; obey response headers.
CROSSREF_FUNDERS_URL=https://api.crossref.org/funders

# Global | crossref | Journal metadata
# GET | REST | CC0 metadata; abstracts and full text may have separate rights. Do not redistribute abstracts by default.
# Observed 200 | JSON | Public lists 1 request/s; single record 5/s; obey response headers.
CROSSREF_JOURNALS_URL=https://api.crossref.org/journals

# Global | crossref | Research by journal
# GET | REST | CC0 metadata; abstracts and full text may have separate rights. Do not redistribute abstracts by default.
# Observed 200 | JSON | Public lists 1 request/s; single record 5/s; obey response headers.
CROSSREF_JOURNAL_WORKS_URL=https://api.crossref.org/journals/{issn}/works

# Global | crossref | Deposited licence vocabulary
# GET | REST | CC0 metadata; abstracts and full text may have separate rights. Do not redistribute abstracts by default.
# Observed 200 | JSON | Public lists 1 request/s; single record 5/s; obey response headers.
CROSSREF_LICENSES_URL=https://api.crossref.org/licenses

# Global | crossref | Publisher member identifiers
# GET | REST | CC0 metadata; abstracts and full text may have separate rights. Do not redistribute abstracts by default.
# Observed 200 | JSON | Public lists 1 request/s; single record 5/s; obey response headers.
CROSSREF_MEMBERS_URL=https://api.crossref.org/members

# Global | crossref | Research output types
# GET | REST | CC0 metadata; abstracts and full text may have separate rights. Do not redistribute abstracts by default.
# Observed 200 | JSON | Public lists 1 request/s; single record 5/s; obey response headers.
CROSSREF_TYPES_URL=https://api.crossref.org/types

# Global | datacite | Search research datasets and DOI metadata
# GET | REST | CC0 DOI metadata; linked datasets retain their own licences.
# Observed 200 | JSON | Public API quota is conditional; obey rate headers/429; conservative 1 request/s.
DATACITE_DOIS_URL=https://api.datacite.org/dois

# Global | datacite | Resolve a research dataset DOI
# GET | REST | CC0 DOI metadata; linked datasets retain their own licences.
# Observed 200 | JSON | Public API quota is conditional; obey rate headers/429; conservative 1 request/s.
DATACITE_DOI_URL=https://api.datacite.org/dois/{doi}

# US | doe | US energy technical reports
# GET | REST | DOE public metadata; full texts may be restricted.
# Observed 200 | JSON | Conservative 1 request/s.
DOE_OSTI_RECORDS_URL=https://www.osti.gov/api/v1/records

# EP | epo-publication | Exact dated EP publication pdf
# GET | REST | EPO publication-service terms; patent documents may include third-party rights; preserve attribution.
# Observed 200 | PDF | Light retrieval only; conservative 1 request/s.
EPO_PUBLICATION_PDF_URL=https://data.epo.org/publication-server/rest/v1.2/publication-dates/{date}/patents/{epDocument}/document.pdf

# EP | epo-publication | Exact dated EP publication xml
# GET | REST | EPO publication-service terms; patent documents may include third-party rights; preserve attribution.
# Observed 200 | XML | Light retrieval only; conservative 1 request/s.
EPO_PUBLICATION_XML_URL=https://data.epo.org/publication-server/rest/v1.2/publication-dates/{date}/patents/{epDocument}/document.xml

# FR | fr-company | French company name/SIREN search
# GET | REST | Source datasets Licence Ouverte/Etalab; API code MIT; do not conflate code and data licences.
# Observed 200 | JSON | Official 7 requests/s/IP and 30/ASN maximum; local cap 1/s.
FR_COMPANY_SEARCH_URL=https://recherche-entreprises.api.gouv.fr/search

# Global | gleif | Legal entity name search
# GET | REST | GLEIF LEI data under CC0; no guarantee of ownership completeness.
# Observed 200 | JSON | Conservative 1 request/s; use pagination and 429 headers.
GLEIF_LEI_SEARCH_URL=https://api.gleif.org/api/v1/lei-records

# France/global | hal | French academic research search
# GET | REST | HAL metadata CC0; deposited files have separate licences.
# Observed 200 | JSON | Conservative 1 request/s; avoid bulk live extraction.
HAL_API_URL=https://api.archives-ouvertes.fr/search/

# France/global | hal | author authority matching
# GET | REST | HAL metadata CC0; deposited files have separate licences.
# Observed 200 | JSON | Conservative 1 request/s; avoid bulk live extraction.
HAL_AUTHOR_URL=https://api.archives-ouvertes.fr/ref/author/

# France/global | hal | structure authority matching
