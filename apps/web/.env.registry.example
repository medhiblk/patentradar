# Observed 200 | JSON | Without key <=3 requests/s; local cap 2.5/s; identify tool.
NCBI_ESEARCH_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi

# US/global | ncbi | NCBI esummary biomedical records
