HAL_STRUCTURE_URL=https://api.archives-ouvertes.fr/ref/structure/

# Europe/global | cern | Physics/engineering literature metadata
# GET | REST | INSPIRE bibliographic metadata CC0; full text separate.
# Observed 200 | JSON | Official 15 requests per 5 seconds/IP; local cap approximately 1 request/s; on 429 wait >=5 seconds.
INSPIRE_LITERATURE_URL=https://inspirehep.net/api/literature

# US | nasa | NASA aerospace technical-report search
# GET | REST | NASA US-government metadata; some contractor publications copyrighted.
# Observed 200 | JSON | Conservative 1 request/s; no SLA assumed.
NASA_NTRS_SEARCH_URL=https://ntrs.nasa.gov/api/citations/search

# US/global | ncbi | NCBI efetch biomedical records
# GET | REST | US government metadata generally public domain; abstracts/third-party content may be copyrighted. Metadata-only default.
# Observed 200 | XML | Without key <=3 requests/s; local cap 2.5/s; identify tool.
NCBI_EFETCH_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi

# US/global | ncbi | NCBI einfo biomedical records
# GET | REST | US government metadata generally public domain; abstracts/third-party content may be copyrighted. Metadata-only default.
