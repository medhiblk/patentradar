# Configuration aliases verified 2026-10-25. Older evidence above remains a dated audit.
# EP XML/PDF retrieval with exact publication number and date; no keyword search.
EPO_PUBLICATION_SERVER_URL=https://data.epo.org/publication-server/rest/v1.2
# Global scholarly work metadata; anonymous basic use only, budget/rate limits apply.
OPENALEX_API_URL=https://api.openalex.org
# Structured organization relations, not patent search.
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
# Scientific MED/PMC records only; no enablement of archived PAT search.
EUROPE_PMC_API_URL=https://www.ebi.ac.uk/europepmc/webservices/rest/search
# Manual import catalogues; HTML is not a callable patent-search API.
USPTO_DATASETS_URL=https://www.uspto.gov/ip-policy/economic-research/research-datasets
# Default legacy URL redirects to an HTML/JS transition guide; files/auth/rights NOT VERIFIED.
PATENTSVIEW_DATA_URL=https://patentsview.org/download/data-downloads
