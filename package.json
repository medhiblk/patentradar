{
  "name": "formaproof-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/n3": "^1.26.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  },
  "scripts": {
    "postinstall": "npm run build:packages && node scripts/prepare-cad-assets.mjs",
    "build:packages": "tsc -b packages/contracts packages/engineering packages/sdk",
    "dev": "npm run build:packages && node scripts/dev.mjs",
    "build": "npm run build:packages && npm run build --workspace @formaproof/web",
    "start": "npm run start --workspace @formaproof/web",
    "typecheck": "npm run build:packages && npm run typecheck --workspace @formaproof/web",
    "lint": "eslint apps/web packages scripts",
    "test": "npm run build:packages && npm run test --workspace @formaproof/web && npm run test --workspace @formaproof/sdk",
    "test:e2e": "npm run test:e2e --workspace @formaproof/web --",
    "check:private-build": "npm run check:private-build --workspace @formaproof/web",
    "sdk:pack": "npm run build:packages && node scripts/pack-sdk.mjs",
    "check:sdk": "npm run sdk:pack && node scripts/verify-sdk.mjs"
  }
}
