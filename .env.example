OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EPO_LINKED_DATA_URL=https://data.epo.org/linked-data
EPO_PUBLICATION_URL=https://data.epo.org/publication-server
# REST root alias takes precedence over legacy EPO_PUBLICATION_URL.
EPO_PUBLICATION_SERVER_URL=https://data.epo.org/publication-server/rest/v1.2
EPO_OPS_KEY=
EPO_OPS_SECRET=
USPTO_API_KEY=
INPI_API_KEY=
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_API_URL=https://api.openalex.org
OPENALEX_API_KEY=
CROSSREF_BASE_URL=https://api.crossref.org
CROSSREF_API_URL=https://api.crossref.org/works
EUROPE_PMC_API_URL=https://www.ebi.ac.uk/europepmc/webservices/rest/search
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_API_KEY=
NCBI_EUTILS_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
NCBI_API_KEY=
LENS_API_TOKEN=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
DATABASE_URL=
NEXT_PUBLIC_APP_NAME=FormaProof

# Audited public endpoint templates and eligibility tiers: see .env.registry.example.
# New metadata adapters (no credentials required)
DATACITE_DOIS_URL=https://api.datacite.org/dois
HAL_API_URL=https://api.archives-ouvertes.fr/search/
ARXIV_API_URL=https://export.arxiv.org/api/query
ZENODO_RECORDS_URL=https://zenodo.org/api/records
OPENAIRE_PUBLICATIONS_URL=https://api.openaire.eu/search/publications
ROR_ORGANIZATIONS_URL=https://api.ror.org/v2/organizations
GLEIF_LEI_SEARCH_URL=https://api.gleif.org/api/v1/lei-records
FR_COMPANY_SEARCH_URL=https://recherche-entreprises.api.gouv.fr/search
NASA_NTRS_SEARCH_URL=https://ntrs.nasa.gov/api/citations/search
DOE_OSTI_RECORDS_URL=https://www.osti.gov/api/v1/records
# Experimental / restricted sources: keep false until rights and usage conditions are cleared.
ENABLE_EXPERIMENTAL_VEYIP=false
ENABLE_EPO_LINKED_REFERENCE=false
ENABLE_GOOGLE_PATENT_PAGES=false
ENABLE_EPMC_PATENT_ARCHIVE=false
ENABLE_SEMANTIC_SCHOLAR=false

# Authenticated BigQuery (disabled until ADC/WIF + project permissions are configured)
ENABLE_BIGQUERY=false
BIGQUERY_MAX_BYTES=1073741824
# Optional shared public-record cache and atomic provider pacing for multiple instances
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Engineering runtime: path to the Python environment containing cad/requirements.txt
CAD_PYTHON=python3
# Server-side persistent volume for accounts, catalog and local sourced patent index
PATENTRADAR_DATA_DIR=
# Count of AI requests allowed per signed-in account per UTC day; not monetary credits
AI_DAILY_CALL_LIMIT=20
# Optional verified public repository URL, shown on the developer portal only after publication
NEXT_PUBLIC_REPOSITORY_URL=

# HTML dataset catalogues, not search APIs. No automatic bulk download/import.
USPTO_DATASETS_URL=https://www.uspto.gov/ip-policy/economic-research/research-datasets
# Legacy URL redirects to the USPTO transition guide; bulk file access NOT VERIFIED.
PATENTSVIEW_DATA_URL=https://patentsview.org/download/data-downloads
