# Build context is the monorepo root. Browser OpenCascade needs no Python.
FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY . .
RUN npm ci && npm run build && npm run check:private-build
# No install hooks at prune time: TypeScript is intentionally removed afterward.
RUN npm prune --omit=dev --ignore-scripts

FROM node:24-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production PATENTRADAR_DATA_DIR=/var/lib/patentradar
COPY --from=build /app/package*.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/web/package.json ./apps/web/package.json
COPY --from=build /app/apps/web/.next ./apps/web/.next
COPY --from=build /app/apps/web/public ./apps/web/public
COPY --from=build /app/apps/web/next.config.ts ./apps/web/next.config.ts
COPY --from=build /app/apps/web/docs ./apps/web/docs
COPY --from=build /app/packages ./packages
RUN mkdir -p /var/lib/patentradar && chown node:node /var/lib/patentradar
USER node
VOLUME /var/lib/patentradar
EXPOSE 3000
CMD ["npm", "start"]
